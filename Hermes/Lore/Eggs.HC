U0 Aletheia()
{
  LoreBanner("a hidden latch");
  "  You found the latch behind the ninth column.\n\n";
  "  There is no secret here, only a reminder: the codex is a map of\n";
  "  what can be checked, and the temple is a place to check it.\n\n";
  "  $$LTGRAY$$Try:$$FG$$ Codex;  MOTD;  Oracle;  LoreCommands;\n";
}
